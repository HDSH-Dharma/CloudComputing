# ---- Supabase (Settings > API) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Service role: ONLY for server-side workers (Maverick's poller, Telegram bot). Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini / Telegram keys live in Edge Function secrets (supabase/functions/.env), NOT here.

# ---- Frontend (apps/web, Flabianos) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
