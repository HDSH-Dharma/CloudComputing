{
  "name": "filamentiq",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r --if-present build",
    "functions:check": "deno check supabase/functions/*/index.ts",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push --remote",
    "db:types": "supabase gen types typescript --linked > supabase/functions/_shared/database.types.ts"
  },
  "dependencies": {
    "@google/genai": "1.30.0",
    "@supabase/supabase-js": "2.47.10",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  }
}
