# Local secrets for `supabase functions serve --env-file supabase/functions/.env`
# Production: `supabase secrets set --env-file supabase/functions/.env` (never commit the real file)
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ASSISTANT_MAX_STEPS=6
ASSISTANT_RATE_LIMIT_PER_MINUTE=10
CORS_ORIGINS=http://localhost:3000,https://filamentiq.example.com
TELEGRAM_BOT_TOKEN=
